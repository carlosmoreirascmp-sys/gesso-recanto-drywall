{
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "Location": "https://gessorecantosp.com.br/$1"
      },
      "status": 308,
      "has": [
        {
          "type": "host",
          "value": "www.gessorecantosp.com.br"
        }
      ]
    },
    {
      "src": "/(?:index(?:\\.html)?)?",
      "headers": {
        "Location": "https://gessorecantosp.com.br/drywall"
      },
      "status": 308,
      "has": [
        {
          "type": "host",
          "value": "obra-drywall.gessorecantosp.com.br"
        }
      ]
    },
    {
      "src": "/(.*)",
      "headers": {
        "Location": "https://gessorecantosp.com.br/drywall/$1"
      },
      "status": 308,
      "has": [
        {
          "type": "host",
          "value": "obra-drywall.gessorecantosp.com.br"
        }
      ]
    },
    {
      "src": "/(?:materiais/?|index(?:\\.html)?)?",
      "headers": {
        "Location": "https://gessorecantosp.com.br/materiais-drywall"
      },
      "status": 308,
      "has": [
        {
          "type": "host",
          "value": "materiaiscompletosdrywall.gessorecantosp.com.br"
        }
      ]
    },
    {
      "src": "/materiais/(.*)",
      "headers": {
        "Location": "https://gessorecantosp.com.br/materiais-drywall/$1"
      },
      "status": 308,
      "has": [
        {
          "type": "host",
          "value": "materiaiscompletosdrywall.gessorecantosp.com.br"
        }
      ]
    },
    {
      "src": "/(.*)",
      "headers": {
        "Location": "https://gessorecantosp.com.br/materiais-drywall/$1"
      },
      "status": 308,
      "has": [
        {
          "type": "host",
          "value": "materiaiscompletosdrywall.gessorecantosp.com.br"
        }
      ]
    },
    {
      "src": "/(drywall|gesso|materiais-drywall)/(?:index(?:\\.html)?)?",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "/(driwal|driwall)/?",
      "headers": {
        "Location": "/drywall"
      },
      "status": 308
    },
    {
      "src": "/gessos/?",
      "headers": {
        "Location": "/gesso"
      },
      "status": 308
    },
    {
      "src": "/materiais(?:/index(?:\\.html)?)?/?",
      "headers": {
        "Location": "/materiais-drywall"
      },
      "status": 308
    },
    {
      "src": "/principal(?:/index(?:\\.html)?)?/?",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "/(?:index(?:\\.html)?)?",
      "has": [
        {
          "type": "host",
          "value": "gessorecantosp.com.br"
        }
      ],
      "dest": "/principal/index.html"
    },
    {
      "src": "/(robots\\.txt|sitemap\\.xml)",
      "has": [
        {
          "type": "host",
          "value": "gessorecantosp.com.br"
        }
      ],
      "dest": "/principal/$1"
    },
    {
      "src": "/(drywall|gesso)",
      "dest": "/$1/index.html"
    },
    {
      "src": "/materiais-drywall",
      "dest": "/materiais/index.html"
    },
    {
      "src": "/drywall/(assets/.*|styles\\.css|main\\.js|robots\\.txt|sitemap\\.xml)",
      "dest": "/$1"
    },
    {
      "src": "/materiais-drywall/(.*)",
      "dest": "/materiais/$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
