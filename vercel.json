{
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.gessorecantosp.com.br"
        }
      ],
      "headers": {
        "Location": "https://gessorecantosp.com.br/$1"
      },
      "status": 308
    },
    {
      "src": "/(?:index(?:\\.html)?)?",
      "has": [
        {
          "type": "host",
          "value": "gessorecantosp.com.br"
        }
      ],
      "dest": "/principal/index.html"
    },
    {
      "src": "/(robots\\.txt|sitemap\\.xml)",
      "has": [
        {
          "type": "host",
          "value": "gessorecantosp.com.br"
        }
      ],
      "dest": "/principal/$1"
    },
    {
      "src": "/(?:index(?:\\.html)?)?",
      "has": [
        {
          "type": "host",
          "value": "materiaiscompletosdrywall.gessorecantosp.com.br"
        }
      ],
      "dest": "/materiais/index.html"
    },
    {
      "src": "/(assets/.*|styles\\.css|main\\.js|robots\\.txt|sitemap\\.xml)",
      "has": [
        {
          "type": "host",
          "value": "materiaiscompletosdrywall.gessorecantosp.com.br"
        }
      ],
      "dest": "/materiais/$1"
    },
    {
      "src": "/(principal|materiais)/?",
      "dest": "/$1/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
